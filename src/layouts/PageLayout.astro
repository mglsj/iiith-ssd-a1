---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout>
    <header
        class="flex flex-none p-4 bg-gray-800 text-white flex-row items-center justify-between"
    >
        <div>Best(est) Student Portal. [Better than IMS]</div>
        <div class="flex flex-row gap-4 items-center">
            <a href="/login" class="text-white hover:underline">Login</a>
        </div>
    </header>

    <main class="flex flex-auto p-4">
        <slot />
    </main>

    <footer class="flex flex-none bg-gray-800 text-white p-4 justify-center">
        <a
            href="https://github.com/mglsj"
            target="_blank"
            class="text-white hover:underline"
        >
            @mglsj
        </a>
        . All lefts reserved.
    </footer>
</BaseLayout>
