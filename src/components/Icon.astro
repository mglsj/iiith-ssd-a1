---
interface Props {
    name:
        | "users"
        | "book"
        | "clock"
        | "check"
        | "chart"
        | "calendar"
        | "target"
        | "bell";
    class?: string;
}

const { name, class: className = "" } = Astro.props;

const paths: Record<Props["name"], string> = {
    users: `<path d="M8 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z"/><path d="M2 21v-1a5 5 0 0 1 5-5h2a5 5 0 0 1 5 5v1"/><path d="M16 8a3 3 0 1 0 0-6"/><path d="M15 10a5 5 0 0 1 5 5v1"/>`,
    book: `<path d="M4 4h12a3 3 0 0 1 3 3v13H7a3 3 0 0 1-3-3V4Z"/><path d="M4 17a3 3 0 0 1 3-3h15"/>`,
    clock: `<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 3.5"/>`,
    check: `<path d="M4 12l6 6L20 6"/>`,
    chart: `<path d="M4 20V10"/><path d="M12 20V4"/><path d="M20 20v-7"/><path d="M2 20h20"/>`,
    calendar: `<rect x="3" y="5" width="18" height="16"/><path d="M3 10h18"/><path d="M8 3v4"/><path d="M16 3v4"/>`,
    target: `<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.2" fill="currentColor"/>`,
    bell: `<path d="M6 10a6 6 0 0 1 12 0c0 5 2 6 2 6H4s2-1 2-6Z"/><path d="M10 20a2 2 0 0 0 4 0"/>`,
};
---

<svg
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2.25"
    stroke-linecap="square"
    stroke-linejoin="miter"
    class={className}
    set:html={paths[name]}
/>
