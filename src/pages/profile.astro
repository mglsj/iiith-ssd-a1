---
import PageLayout from "@/layouts/PageLayout.astro";

const studentData = {
  name: "Alex Johnson",
  rollNo: "2026201063",
  email: "alex.johnson@iiit.ac.in",
  major: "Computer Science",
  semester: "4th Semester",
  gpa: "8.5/10",
  bio: "Passionate about web development and machine learning. Love building scalable applications and exploring new technologies.",
  courses: [
    { code: "CS101", name: "Data Structures", grade: "A" },
    { code: "CS102", name: "Web Development", grade: "A+" },
    { code: "CS103", name: "Database Systems", grade: "A" },
    { code: "CS104", name: "Operating Systems", grade: "B+" }
  ],
  skills: ["JavaScript", "Python", "React", "Astro", "SQL", "Git"],
  projects: [
    { title: "E-commerce Platform", description: "Built a full-stack e-commerce platform using React and Node.js" },
    { title: "ML Model for Image Classification", description: "Implemented a CNN model for image classification using TensorFlow" }
  ]
};
---

<PageLayout>
    <div class="min-h-screen bg-gradient-to-br from-blue-50 to-indigo-100 py-12 px-4 sm:px-6 lg:px-8">
        <div class="max-w-4xl mx-auto">
            <!-- Profile Header -->
            <div class="bg-white rounded-lg shadow-lg overflow-hidden mb-8">
                <div class="bg-gradient-to-r from-blue-600 to-indigo-600 h-32"></div>
                <div class="px-6 pb-6">
                    <div class="flex flex-col sm:flex-row sm:items-end sm:space-x-5 -mt-16 relative z-10">
                        <div class="w-32 h-32 bg-gradient-to-br from-blue-400 to-indigo-600 rounded-full border-4 border-white shadow-lg flex items-center justify-center">
                            <span class="text-white text-5xl font-bold">{studentData.name.charAt(0)}</span>
                        </div>
                        <div class="mt-4 sm:mt-0 flex-1">
                            <h1 class="text-3xl font-bold text-gray-900">{studentData.name}</h1>
                            <p class="text-gray-600 text-lg">{studentData.major}</p>
                            <p class="text-gray-500">Roll No: {studentData.rollNo}</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Contact & Basic Info -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
                <div class="bg-white rounded-lg shadow p-6">
                    <h2 class="text-xl font-semibold text-gray-900 mb-4">Contact Information</h2>
                    <div class="space-y-3">
                        <div>
                            <p class="text-gray-600 text-sm">Email</p>
                            <p class="text-gray-900 font-medium">{studentData.email}</p>
                        </div>
                        <div>
                            <p class="text-gray-600 text-sm">Semester</p>
                            <p class="text-gray-900 font-medium">{studentData.semester}</p>
                        </div>
                    </div>
                </div>

                <div class="bg-white rounded-lg shadow p-6">
                    <h2 class="text-xl font-semibold text-gray-900 mb-4">Academic Performance</h2>
                    <div class="space-y-3">
                        <div>
                            <p class="text-gray-600 text-sm">Current GPA</p>
                            <div class="flex items-center">
                                <div class="text-3xl font-bold text-indigo-600">{studentData.gpa}</div>
                                <div class="ml-4 w-24 h-2 bg-gray-200 rounded-full overflow-hidden">
                                    <div class="h-full bg-green-500" style="width: 85%;"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Bio -->
            <div class="bg-white rounded-lg shadow p-6 mb-8">
                <h2 class="text-xl font-semibold text-gray-900 mb-4">About</h2>
                <p class="text-gray-700 leading-relaxed">{studentData.bio}</p>
            </div>

            <!-- Current Courses -->
            <div class="bg-white rounded-lg shadow p-6 mb-8">
                <h2 class="text-xl font-semibold text-gray-900 mb-4">Current Courses</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    {studentData.courses.map(course => (
                        <div class="border border-gray-200 rounded-lg p-4 hover:border-indigo-400 hover:bg-indigo-50 transition">
                            <div class="flex justify-between items-start">
                                <div>
                                    <p class="font-semibold text-gray-900">{course.name}</p>
                                    <p class="text-gray-600 text-sm">{course.code}</p>
                                </div>
                                <span class="bg-green-100 text-green-800 px-3 py-1 rounded-full text-sm font-medium">{course.grade}</span>
                            </div>
                        </div>
                    ))}
                </div>
            </div>

            <!-- Skills -->
            <div class="bg-white rounded-lg shadow p-6 mb-8">
                <h2 class="text-xl font-semibold text-gray-900 mb-4">Skills</h2>
                <div class="flex flex-wrap gap-2">
                    {studentData.skills.map(skill => (
                        <span class="bg-indigo-100 text-indigo-800 px-4 py-2 rounded-full text-sm font-medium">
                            {skill}
                        </span>
                    ))}
                </div>
            </div>

            <!-- Projects -->
            <div class="bg-white rounded-lg shadow p-6">
                <h2 class="text-xl font-semibold text-gray-900 mb-4">Projects</h2>
                <div class="space-y-4">
                    {studentData.projects.map(project => (
                        <div class="border-l-4 border-indigo-600 pl-4 py-2">
                            <h3 class="font-semibold text-gray-900">{project.title}</h3>
                            <p class="text-gray-700 text-sm mt-1">{project.description}</p>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    </div>
</PageLayout>
