---
import PageLayout from "@/layouts/PageLayout.astro";

const studentData = {
  name: "Alex Johnson",
  rollNo: "2026201063",
  email: "alex.johnson@iiit.ac.in",
  major: "Computer Science",
  semester: "4th Semester",
  gpa: "8.5/10",
  bio: "Passionate about web development and machine learning. Love building scalable applications and exploring new technologies.",
  courses: [
    { code: "CS101", name: "Data Structures", grade: "A" },
    { code: "CS102", name: "Web Development", grade: "A+" },
    { code: "CS103", name: "Database Systems", grade: "A" },
    { code: "CS104", name: "Operating Systems", grade: "B+" }
  ],
  skills: ["JavaScript", "Python", "React", "Astro", "SQL", "Git"],
  projects: [
    { title: "E-commerce Platform", description: "Built a full-stack e-commerce platform using React and Node.js" },
    { title: "ML Model for Image Classification", description: "Implemented a CNN model for image classification using TensorFlow" }
  ]
};
---

<PageLayout>
    <div class="flex-auto py-12 px-4 sm:px-6 lg:px-8">
        <div class="max-w-4xl mx-auto">
            <!-- Profile Header -->
            <div class="brutal-panel overflow-hidden mb-8">
                <div class="bg-ink h-24 border-b-[3px] border-ink"></div>
                <div class="px-6 pb-6">
                    <div class="flex flex-col sm:flex-row sm:items-end sm:space-x-5 -mt-14 relative z-10">
                        <div class="w-28 h-28 bg-accent brutal-border flex items-center justify-center">
                            <span class="text-ink text-5xl font-black">{studentData.name.charAt(0)}</span>
                        </div>
                        <div class="mt-4 sm:mt-0 flex-1 bg-paper brutal-border px-4 py-3">
                            <h1 class="text-3xl font-black uppercase tracking-tight text-ink">{studentData.name}</h1>
                            <p class="text-lg font-mono text-ink">{studentData.major}</p>
                            <p class="text-ink/60 font-mono text-sm">Roll No: {studentData.rollNo}</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Contact & Basic Info -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
                <div class="brutal-panel p-6">
                    <h2 class="text-xl font-black mb-4 uppercase">Contact Information</h2>
                    <div class="space-y-3">
                        <div>
                            <p class="text-sm font-bold uppercase text-ink/60">Email</p>
                            <p class="font-mono">{studentData.email}</p>
                        </div>
                        <div>
                            <p class="text-sm font-bold uppercase text-ink/60">Semester</p>
                            <p class="font-mono">{studentData.semester}</p>
                        </div>
                    </div>
                </div>

                <div class="brutal-panel p-6">
                    <h2 class="text-xl font-black mb-4 uppercase">Academic Performance</h2>
                    <div class="space-y-3">
                        <div>
                            <p class="text-sm font-bold uppercase text-ink/60">Current GPA</p>
                            <div class="flex items-center">
                                <div class="text-3xl font-black text-accent-2 font-mono">{studentData.gpa}</div>
                                <div class="ml-4 w-24 h-3 brutal-border bg-paper overflow-hidden">
                                    <div class="h-full bg-ok" style="width: 85%;"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Bio -->
            <div class="brutal-panel p-6 mb-8">
                <h2 class="text-xl font-black mb-4 uppercase">About</h2>
                <p class="leading-relaxed">{studentData.bio}</p>
            </div>

            <!-- Current Courses -->
            <div class="brutal-panel p-6 mb-8">
                <h2 class="text-xl font-black mb-4 uppercase">Current Courses</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    {studentData.courses.map(course => (
                        <div class="brutal-border p-4 hover:bg-accent/20 transition">
                            <div class="flex justify-between items-start">
                                <div>
                                    <p class="font-bold">{course.name}</p>
                                    <p class="text-ink/60 text-sm font-mono">{course.code}</p>
                                </div>
                                <span class="brutal-tag bg-ok text-paper px-3 py-1 text-sm">{course.grade}</span>
                            </div>
                        </div>
                    ))}
                </div>
            </div>

            <!-- Skills -->
            <div class="brutal-panel p-6 mb-8">
                <h2 class="text-xl font-black mb-4 uppercase">Skills</h2>
                <div class="flex flex-wrap gap-2">
                    {studentData.skills.map(skill => (
                        <span class="brutal-tag bg-accent-3 text-paper px-4 py-2 text-sm">
                            {skill}
                        </span>
                    ))}
                </div>
            </div>

            <!-- Projects -->
            <div class="brutal-panel p-6">
                <h2 class="text-xl font-black mb-4 uppercase">Projects</h2>
                <div class="space-y-4">
                    {studentData.projects.map(project => (
                        <div class="border-l-4 border-ink pl-4 py-2">
                            <h3 class="font-bold">{project.title}</h3>
                            <p class="text-ink/70 text-sm mt-1">{project.description}</p>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    </div>
</PageLayout>
