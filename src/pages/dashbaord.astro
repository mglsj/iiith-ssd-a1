---
import PageLayout from "@/layouts/PageLayout.astro";
---

<PageLayout>
    <div class="min-h-screen bg-gradient-to-br from-slate-900 to-slate-800">
        <div class="p-6">
            <!-- Header -->
            <div class="mb-8">
                <h1 class="text-4xl font-bold text-white">Admin Dashboard</h1>
                <p class="text-slate-400 mt-2">Welcome back, Administrator</p>
            </div>

            <!-- Key Metrics -->
            <div
                class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8"
            >
                <!-- Total Students -->
                <div
                    class="bg-gradient-to-br from-blue-600 to-blue-700 rounded-lg shadow-lg p-6 text-white"
                >
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-blue-100 text-sm">Total Students</p>
                            <p class="text-4xl font-bold mt-2">5,240</p>
                            <p class="text-blue-200 text-xs mt-2">
                                ↑ 12% from last month
                            </p>
                        </div>
                        <div class="text-5xl opacity-30">👥</div>
                    </div>
                </div>

                <!-- Active Courses -->
                <div
                    class="bg-gradient-to-br from-purple-600 to-purple-700 rounded-lg shadow-lg p-6 text-white"
                >
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-purple-100 text-sm">
                                Active Courses
                            </p>
                            <p class="text-4xl font-bold mt-2">127</p>
                            <p class="text-purple-200 text-xs mt-2">
                                ↑ 8% from last semester
                            </p>
                        </div>
                        <div class="text-5xl opacity-30">📚</div>
                    </div>
                </div>

                <!-- Pending Approvals -->
                <div
                    class="bg-gradient-to-br from-orange-600 to-orange-700 rounded-lg shadow-lg p-6 text-white"
                >
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-orange-100 text-sm">
                                Pending Approvals
                            </p>
                            <p class="text-4xl font-bold mt-2">23</p>
                            <p class="text-orange-200 text-xs mt-2">
                                Requires immediate action
                            </p>
                        </div>
                        <div class="text-5xl opacity-30">⏳</div>
                    </div>
                </div>

                <!-- System Health -->
                <div
                    class="bg-gradient-to-br from-green-600 to-green-700 rounded-lg shadow-lg p-6 text-white"
                >
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-green-100 text-sm">System Health</p>
                            <p class="text-4xl font-bold mt-2">99.8%</p>
                            <p class="text-green-200 text-xs mt-2">
                                Uptime - All systems OK
                            </p>
                        </div>
                        <div class="text-5xl opacity-30">✓</div>
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                <!-- Main Content Area -->
                <div class="lg:col-span-2 space-y-6">
                    <!-- Recent Activity -->
                    <div class="bg-slate-800 rounded-lg shadow-lg p-6">
                        <h2 class="text-xl font-bold text-white mb-4">
                            Recent Activity
                        </h2>
                        <div class="space-y-3">
                            <div
                                class="flex items-center justify-between p-3 bg-slate-700 rounded-lg hover:bg-slate-600 transition"
                            >
                                <div class="flex items-center space-x-3">
                                    <div
                                        class="w-10 h-10 bg-blue-500 rounded-full flex items-center justify-center text-white font-bold"
                                    >
                                        R
                                    </div>
                                    <div>
                                        <p class="text-white font-medium">
                                            New student registration
                                        </p>
                                        <p class="text-slate-400 text-sm">
                                            2 hours ago
                                        </p>
                                    </div>
                                </div>
                                <span
                                    class="text-blue-400 text-sm font-semibold"
                                    >+45 students</span
                                >
                            </div>

                            <div
                                class="flex items-center justify-between p-3 bg-slate-700 rounded-lg hover:bg-slate-600 transition"
                            >
                                <div class="flex items-center space-x-3">
                                    <div
                                        class="w-10 h-10 bg-purple-500 rounded-full flex items-center justify-center text-white font-bold"
                                    >
                                        C
                                    </div>
                                    <div>
                                        <p class="text-white font-medium">
                                            Course grades uploaded
                                        </p>
                                        <p class="text-slate-400 text-sm">
                                            4 hours ago
                                        </p>
                                    </div>
                                </div>
                                <span
                                    class="text-purple-400 text-sm font-semibold"
                                    >CS101, CS102</span
                                >
                            </div>

                            <div
                                class="flex items-center justify-between p-3 bg-slate-700 rounded-lg hover:bg-slate-600 transition"
                            >
                                <div class="flex items-center space-x-3">
                                    <div
                                        class="w-10 h-10 bg-green-500 rounded-full flex items-center justify-center text-white font-bold"
                                    >
                                        A
                                    </div>
                                    <div>
                                        <p class="text-white font-medium">
                                            Admin account created
                                        </p>
                                        <p class="text-slate-400 text-sm">
                                            1 day ago
                                        </p>
                                    </div>
                                </div>
                                <span
                                    class="text-green-400 text-sm font-semibold"
                                    >Dr. Smith</span
                                >
                            </div>

                            <div
                                class="flex items-center justify-between p-3 bg-slate-700 rounded-lg hover:bg-slate-600 transition"
                            >
                                <div class="flex items-center space-x-3">
                                    <div
                                        class="w-10 h-10 bg-orange-500 rounded-full flex items-center justify-center text-white font-bold"
                                    >
                                        I
                                    </div>
                                    <div>
                                        <p class="text-white font-medium">
                                            System maintenance completed
                                        </p>
                                        <p class="text-slate-400 text-sm">
                                            2 days ago
                                        </p>
                                    </div>
                                </div>
                                <span
                                    class="text-orange-400 text-sm font-semibold"
                                    >Database</span
                                >
                            </div>
                        </div>
                    </div>

                    <!-- User Management -->
                    <div class="bg-slate-800 rounded-lg shadow-lg p-6">
                        <div class="flex items-center justify-between mb-4">
                            <h2 class="text-xl font-bold text-white">
                                User Management
                            </h2>
                            <button
                                class="bg-indigo-600 text-white px-4 py-2 rounded-lg hover:bg-indigo-700 transition text-sm font-semibold"
                                >+ Add User</button
                            >
                        </div>

                        <div class="overflow-x-auto">
                            <table class="w-full text-left text-slate-300">
                                <thead
                                    class="text-slate-400 border-b border-slate-700"
                                >
                                    <tr>
                                        <th class="pb-3">Name</th>
                                        <th class="pb-3">Email</th>
                                        <th class="pb-3">Role</th>
                                        <th class="pb-3">Status</th>
                                        <th class="pb-3">Action</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-slate-700">
                                    <tr class="hover:bg-slate-700 transition">
                                        <td class="py-3 font-medium text-white"
                                            >John Doe</td
                                        >
                                        <td class="py-3">john.doe@iiit.ac.in</td
                                        >
                                        <td class="py-3"
                                            ><span
                                                class="bg-blue-900 text-blue-200 px-2 py-1 rounded text-xs"
                                                >Student</span
                                            ></td
                                        >
                                        <td class="py-3"
                                            ><span
                                                class="bg-green-900 text-green-200 px-2 py-1 rounded text-xs"
                                                >Active</span
                                            ></td
                                        >
                                        <td class="py-3"
                                            ><button
                                                class="text-indigo-400 hover:text-indigo-300"
                                                >Edit</button
                                            ></td
                                        >
                                    </tr>
                                    <tr class="hover:bg-slate-700 transition">
                                        <td class="py-3 font-medium text-white"
                                            >Dr. Sarah Smith</td
                                        >
                                        <td class="py-3"
                                            >sarah.smith@iiit.ac.in</td
                                        >
                                        <td class="py-3"
                                            ><span
                                                class="bg-purple-900 text-purple-200 px-2 py-1 rounded text-xs"
                                                >Faculty</span
                                            ></td
                                        >
                                        <td class="py-3"
                                            ><span
                                                class="bg-green-900 text-green-200 px-2 py-1 rounded text-xs"
                                                >Active</span
                                            ></td
                                        >
                                        <td class="py-3"
                                            ><button
                                                class="text-indigo-400 hover:text-indigo-300"
                                                >Edit</button
                                            ></td
                                        >
                                    </tr>
                                    <tr class="hover:bg-slate-700 transition">
                                        <td class="py-3 font-medium text-white"
                                            >Admin User</td
                                        >
                                        <td class="py-3">admin@iiit.ac.in</td>
                                        <td class="py-3"
                                            ><span
                                                class="bg-red-900 text-red-200 px-2 py-1 rounded text-xs"
                                                >Admin</span
                                            ></td
                                        >
                                        <td class="py-3"
                                            ><span
                                                class="bg-green-900 text-green-200 px-2 py-1 rounded text-xs"
                                                >Active</span
                                            ></td
                                        >
                                        <td class="py-3"
                                            ><button
                                                class="text-indigo-400 hover:text-indigo-300"
                                                >Edit</button
                                            ></td
                                        >
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Sidebar -->
                <div class="space-y-6">
                    <!-- Quick Actions -->
                    <div class="bg-slate-800 rounded-lg shadow-lg p-6">
                        <h2 class="text-xl font-bold text-white mb-4">
                            Quick Actions
                        </h2>
                        <div class="space-y-2">
                            <button
                                class="w-full bg-indigo-600 hover:bg-indigo-700 text-white p-2 rounded-lg transition text-sm font-semibold"
                            >
                                Create New Course
                            </button>
                            <button
                                class="w-full bg-blue-600 hover:bg-blue-700 text-white p-2 rounded-lg transition text-sm font-semibold"
                            >
                                Manage Users
                            </button>
                            <button
                                class="w-full bg-purple-600 hover:bg-purple-700 text-white p-2 rounded-lg transition text-sm font-semibold"
                            >
                                View Reports
                            </button>
                            <button
                                class="w-full bg-orange-600 hover:bg-orange-700 text-white p-2 rounded-lg transition text-sm font-semibold"
                            >
                                System Settings
                            </button>
                        </div>
                    </div>

                    <!-- System Status -->
                    <div class="bg-slate-800 rounded-lg shadow-lg p-6">
                        <h2 class="text-xl font-bold text-white mb-4">
                            System Status
                        </h2>
                        <div class="space-y-3">
                            <div>
                                <div class="flex justify-between mb-1">
                                    <span class="text-slate-300 text-sm"
                                        >Database</span
                                    >
                                    <span
                                        class="text-green-400 text-sm font-semibold"
                                        >Online</span
                                    >
                                </div>
                                <div
                                    class="w-full bg-slate-700 rounded-full h-2"
                                >
                                    <div
                                        class="bg-green-500 h-2 rounded-full"
                                        style="width: 100%;"
                                    >
                                    </div>
                                </div>
                            </div>

                            <div>
                                <div class="flex justify-between mb-1">
                                    <span class="text-slate-300 text-sm"
                                        >API Server</span
                                    >
                                    <span
                                        class="text-green-400 text-sm font-semibold"
                                        >Online</span
                                    >
                                </div>
                                <div
                                    class="w-full bg-slate-700 rounded-full h-2"
                                >
                                    <div
                                        class="bg-green-500 h-2 rounded-full"
                                        style="width: 100%;"
                                    >
                                    </div>
                                </div>
                            </div>

                            <div>
                                <div class="flex justify-between mb-1">
                                    <span class="text-slate-300 text-sm"
                                        >Cache</span
                                    >
                                    <span
                                        class="text-green-400 text-sm font-semibold"
                                        >Online</span
                                    >
                                </div>
                                <div
                                    class="w-full bg-slate-700 rounded-full h-2"
                                >
                                    <div
                                        class="bg-green-500 h-2 rounded-full"
                                        style="width: 100%;"
                                    >
                                    </div>
                                </div>
                            </div>

                            <div>
                                <div class="flex justify-between mb-1">
                                    <span class="text-slate-300 text-sm"
                                        >Email Service</span
                                    >
                                    <span
                                        class="text-yellow-400 text-sm font-semibold"
                                        >Degraded</span
                                    >
                                </div>
                                <div
                                    class="w-full bg-slate-700 rounded-full h-2"
                                >
                                    <div
                                        class="bg-yellow-500 h-2 rounded-full"
                                        style="width: 75%;"
                                    >
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Recent Logins -->
                    <div class="bg-slate-800 rounded-lg shadow-lg p-6">
                        <h2 class="text-xl font-bold text-white mb-4">
                            Top Users This Week
                        </h2>
                        <div class="space-y-2">
                            <div
                                class="flex justify-between items-center p-2 bg-slate-700 rounded"
                            >
                                <span class="text-white text-sm"
                                    >Alex Johnson</span
                                >
                                <span class="text-slate-400 text-xs"
                                    >124 logins</span
                                >
                            </div>
                            <div
                                class="flex justify-between items-center p-2 bg-slate-700 rounded"
                            >
                                <span class="text-white text-sm"
                                    >Maria Garcia</span
                                >
                                <span class="text-slate-400 text-xs"
                                    >98 logins</span
                                >
                            </div>
                            <div
                                class="flex justify-between items-center p-2 bg-slate-700 rounded"
                            >
                                <span class="text-white text-sm">Dr. Kim</span>
                                <span class="text-slate-400 text-xs"
                                    >87 logins</span
                                >
                            </div>
                            <div
                                class="flex justify-between items-center p-2 bg-slate-700 rounded"
                            >
                                <span class="text-white text-sm"
                                    >James Wilson</span
                                >
                                <span class="text-slate-400 text-xs"
                                    >72 logins</span
                                >
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</PageLayout>
