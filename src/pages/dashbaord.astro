---
import PageLayout from "@/layouts/PageLayout.astro";
import Icon from "@/components/Icon.astro";

const metrics = [
    {
        label: "Total Students",
        value: "5,240",
        note: "↑ 12% from last month",
        color: "bg-accent-3 text-paper",
        icon: "users" as const,
    },
    {
        label: "Active Courses",
        value: "127",
        note: "↑ 8% from last semester",
        color: "bg-accent text-ink",
        icon: "book" as const,
    },
    {
        label: "Pending Approvals",
        value: "23",
        note: "Requires immediate action",
        color: "bg-accent-2 text-paper",
        icon: "clock" as const,
    },
    {
        label: "System Health",
        value: "99.8%",
        note: "Uptime - All systems OK",
        color: "bg-ok text-paper",
        icon: "check" as const,
    },
];

const activity = [
    {
        letter: "R",
        title: "New student registration",
        time: "2 hours ago",
        tag: "+45 students",
    },
    {
        letter: "C",
        title: "Course grades uploaded",
        time: "4 hours ago",
        tag: "CS101, CS102",
    },
    {
        letter: "A",
        title: "Admin account created",
        time: "1 day ago",
        tag: "Dr. Smith",
    },
    {
        letter: "I",
        title: "System maintenance completed",
        time: "2 days ago",
        tag: "Database",
    },
];

const users = [
    {
        name: "John Doe",
        email: "john.doe@iiit.ac.in",
        role: "Student",
        status: "Active",
    },
    {
        name: "Dr. Sarah Smith",
        email: "sarah.smith@iiit.ac.in",
        role: "Faculty",
        status: "Active",
    },
    {
        name: "Admin User",
        email: "admin@iiit.ac.in",
        role: "Admin",
        status: "Active",
    },
];

const quickActions = [
    "Create New Course",
    "Manage Users",
    "View Reports",
    "System Settings",
];

const systemStatus = [
    { label: "Database", status: "Online", pct: 100 },
    { label: "API Server", status: "Online", pct: 100 },
    { label: "Cache", status: "Online", pct: 100 },
    { label: "Email Service", status: "Degraded", pct: 75 },
];

const topUsers = [
    { name: "Alex Johnson", logins: "124 logins" },
    { name: "Maria Garcia", logins: "98 logins" },
    { name: "Dr. Kim", logins: "87 logins" },
    { name: "James Wilson", logins: "72 logins" },
];
---

<PageLayout>
    <div class="w-full flex-auto bg-paper">
        <div class="w-full p-4 sm:p-6">
            <!-- Header -->
            <div class="mb-8">
                <h1 class="text-3xl sm:text-4xl font-black uppercase tracking-tight">
                    Admin Dashboard
                </h1>
                <p class="mt-2 font-mono text-sm text-ink/70">
                    Welcome back, Administrator
                </p>
            </div>

            <!-- Key Metrics -->
            <div
                class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8"
            >
                {
                    metrics.map((m) => (
                        <div
                            class={`brutal-panel p-6 ${m.color}`}
                            role="group"
                            aria-label={`${m.label}: ${m.value}. ${m.note}`}
                        >
                            <div class="flex items-center justify-between">
                                <div>
                                    <p class="text-sm font-bold uppercase opacity-80">
                                        {m.label}
                                    </p>
                                    <p class="text-4xl font-black mt-2 font-mono">
                                        {m.value}
                                    </p>
                                    <p class="text-xs mt-2 opacity-80 font-mono">
                                        {m.note}
                                    </p>
                                </div>
                                <div class="opacity-30" aria-hidden="true">
                                    <Icon name={m.icon} class="w-14 h-14" />
                                </div>
                            </div>
                        </div>
                    ))
                }
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                <!-- Main Content Area -->
                <div class="lg:col-span-2 space-y-6">
                    <!-- Recent Activity -->
                    <div class="brutal-panel p-6">
                        <h2 class="text-xl font-black mb-4 uppercase">
                            Recent Activity
                        </h2>
                        <div class="space-y-3">
                            {
                                activity.map((a) => (
                                    <div class="flex items-center justify-between p-3 brutal-border">
                                        <div class="flex items-center space-x-3">
                                            <div class="w-10 h-10 bg-accent-3 text-paper brutal-border flex items-center justify-center font-black">
                                                {a.letter}
                                            </div>
                                            <div>
                                                <p class="font-bold">
                                                    {a.title}
                                                </p>
                                                <p class="text-ink/60 text-sm font-mono">
                                                    {a.time}
                                                </p>
                                            </div>
                                        </div>
                                        <span class="brutal-tag bg-accent px-2 py-1 text-xs">
                                            {a.tag}
                                        </span>
                                    </div>
                                ))
                            }
                        </div>
                    </div>

                    <!-- User Management -->
                    <div class="brutal-panel p-6">
                        <div class="flex items-center justify-between mb-4">
                            <h2 class="text-xl font-black uppercase">
                                User Management
                            </h2>
                            <button class="brutal-btn px-4 py-2 text-sm">
                                + Add User
                            </button>
                        </div>

                        <div class="overflow-x-auto">
                            <table class="w-full text-left">
                                <thead
                                    class="uppercase text-sm border-b-[3px] border-ink"
                                >
                                    <tr>
                                        <th class="pb-3">Name</th>
                                        <th class="pb-3">Email</th>
                                        <th class="pb-3">Role</th>
                                        <th class="pb-3">Status</th>
                                        <th class="pb-3">Action</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y-2 divide-ink/20">
                                    {
                                        users.map((u) => (
                                            <tr>
                                                <td class="py-3 font-bold">
                                                    {u.name}
                                                </td>
                                                <td class="py-3 font-mono text-sm">
                                                    {u.email}
                                                </td>
                                                <td class="py-3">
                                                    <span class="brutal-tag bg-accent-3 text-paper px-2 py-1 text-xs">
                                                        {u.role}
                                                    </span>
                                                </td>
                                                <td class="py-3">
                                                    <span class="brutal-tag bg-ok text-paper px-2 py-1 text-xs">
                                                        {u.status}
                                                    </span>
                                                </td>
                                                <td class="py-3">
                                                    <button class="font-bold underline underline-offset-4">
                                                        Edit
                                                    </button>
                                                </td>
                                            </tr>
                                        ))
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Sidebar -->
                <div class="space-y-6">
                    <!-- Quick Actions -->
                    <div class="brutal-panel p-6">
                        <h2 class="text-xl font-black mb-4 uppercase">
                            Quick Actions
                        </h2>
                        <div class="space-y-2">
                            {
                                quickActions.map((a) => (
                                    <button class="brutal-btn brutal-btn-outline w-full p-2 text-sm">
                                        {a}
                                    </button>
                                ))
                            }
                        </div>
                    </div>

                    <!-- System Status -->
                    <div class="brutal-panel p-6">
                        <h2 class="text-xl font-black mb-4 uppercase">
                            System Status
                        </h2>
                        <div class="space-y-4">
                            {
                                systemStatus.map((s) => (
                                    <div>
                                        <div class="flex justify-between mb-1">
                                            <span class="text-sm font-bold">
                                                {s.label}
                                            </span>
                                            <span
                                                class={`text-sm font-black font-mono ${s.status === "Online" ? "text-ok" : "text-accent-2"}`}
                                            >
                                                {s.status}
                                            </span>
                                        </div>
                                        <div class="w-full brutal-border h-3 bg-paper">
                                            <div
                                                class={`h-full ${s.status === "Online" ? "bg-ok" : "bg-accent-2"}`}
                                                style={`width: ${s.pct}%;`}
                                            />
                                        </div>
                                    </div>
                                ))
                            }
                        </div>
                    </div>

                    <!-- Top Users -->
                    <div class="brutal-panel p-6">
                        <h2 class="text-xl font-black mb-4 uppercase">
                            Top Users This Week
                        </h2>
                        <div class="space-y-2">
                            {
                                topUsers.map((u) => (
                                    <div class="flex justify-between items-center p-2 brutal-border">
                                        <span class="text-sm font-bold">
                                            {u.name}
                                        </span>
                                        <span class="text-xs font-mono text-ink/60">
                                            {u.logins}
                                        </span>
                                    </div>
                                ))
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</PageLayout>
