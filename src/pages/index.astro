---
import PageLayout from "@/layouts/PageLayout.astro";
import Icon from "@/components/Icon.astro";

const features = [
    {
        icon: "book" as const,
        title: "Course Management",
        desc: "View all your enrolled courses, access course materials, and stay updated with assignments and deadlines.",
    },
    {
        icon: "chart" as const,
        title: "Grade Tracking",
        desc: "Monitor your academic performance with real-time grade updates and detailed performance analytics.",
    },
    {
        icon: "users" as const,
        title: "Student Network",
        desc: "Connect with classmates, form study groups, and collaborate on projects with your peers.",
    },
    {
        icon: "calendar" as const,
        title: "Schedule & Events",
        desc: "Keep track of class schedules, exam dates, and important academic events all in one place.",
    },
    {
        icon: "target" as const,
        title: "Progress Insights",
        desc: "Get personalized insights into your academic progress and recommendations for improvement.",
    },
    {
        icon: "bell" as const,
        title: "Smart Notifications",
        desc: "Receive timely notifications for assignments, grades, and important announcements from instructors.",
    },
];

const benefits = [
    {
        title: "Intuitive Design",
        desc: "Easy to navigate interface designed with students in mind.",
    },
    {
        title: "Real-time Updates",
        desc: "Stay informed with instant notifications and live data.",
    },
    {
        title: "Mobile Friendly",
        desc: "Access your portal anywhere, anytime on any device.",
    },
    {
        title: "Secure & Private",
        desc: "Your academic data is protected with enterprise-grade security.",
    },
];

const stats = [
    { value: "5000+", label: "Active Students" },
    { value: "500+", label: "Courses Managed" },
    { value: "98%", label: "User Satisfaction" },
    { value: "24/7", label: "Support Available" },
];
---

<PageLayout>
    <div class="w-full bg-paper">
        <!-- Hero Section -->
        <section
            class="min-h-[85vh] bg-ink flex items-center justify-center px-4 sm:px-6 lg:px-8 border-b-4 border-ink"
        >
            <div class="max-w-5xl mx-auto text-center">
                <h1
                    class="text-5xl sm:text-6xl lg:text-7xl font-black text-paper mb-6 leading-none uppercase tracking-tight"
                >
                    Welcome to <span class="text-accent">Student Portal</span>
                </h1>
                <p
                    class="text-lg sm:text-xl text-paper/80 mb-10 max-w-3xl mx-auto font-mono"
                >
                    Your complete academic companion. Manage courses, track
                    grades, and stay connected with your academic journey.
                </p>
                <div class="flex flex-col sm:flex-row gap-4 justify-center">
                    <a href="/login" class="brutal-btn px-8 py-3 text-base">
                        Get Started
                    </a>
                    <a
                        href="#features"
                        class="brutal-btn brutal-btn-outline text-paper border-paper px-8 py-3 text-base"
                    >
                        Learn More
                    </a>
                </div>
            </div>
        </section>

        <!-- Features Section -->
        <section id="features" class="py-20 px-4 sm:px-6 lg:px-8">
            <div class="max-w-6xl mx-auto">
                <h2
                    class="text-3xl sm:text-4xl font-black text-center mb-16 uppercase tracking-tight"
                >
                    Powerful Features
                </h2>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                    {
                        features.map((f) => (
                            <div class="brutal-panel p-8">
                                <div class="w-16 h-16 bg-accent brutal-border flex items-center justify-center mb-4 text-ink">
                                    <Icon name={f.icon} class="w-8 h-8" />
                                </div>
                                <h3 class="text-xl font-black mb-3 uppercase">
                                    {f.title}
                                </h3>
                                <p class="text-ink/70">{f.desc}</p>
                            </div>
                        ))
                    }
                </div>
            </div>
        </section>

        <!-- Benefits Section -->
        <section
            class="py-20 px-4 sm:px-6 lg:px-8 bg-ink border-y-4 border-ink"
        >
            <div class="max-w-5xl mx-auto">
                <h2
                    class="text-3xl sm:text-4xl font-black text-paper text-center mb-16 uppercase tracking-tight"
                >
                    Why Choose Student Portal?
                </h2>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                    {
                        benefits.map((b) => (
                            <div class="flex gap-4">
                                <div class="shrink-0">
                                    <div class="flex items-center justify-center h-12 w-12 bg-accent border-[3px] border-paper text-ink">
                                        <Icon name="check" class="w-6 h-6" />
                                    </div>
                                </div>
                                <div>
                                    <h3 class="text-xl font-bold text-paper mb-2 uppercase">
                                        {b.title}
                                    </h3>
                                    <p class="text-paper/70">{b.desc}</p>
                                </div>
                            </div>
                        ))
                    }
                </div>
            </div>
        </section>

        <!-- CTA Section -->
        <section class="py-20 px-4 sm:px-6 lg:px-8">
            <div class="max-w-4xl mx-auto">
                <div class="brutal-panel bg-accent p-12 text-center">
                    <h2
                        class="text-3xl sm:text-4xl font-black mb-4 uppercase tracking-tight"
                    >
                        Ready to Transform Your Academic Journey?
                    </h2>
                    <p class="text-ink/80 text-lg mb-8 font-mono">
                        Join thousands of students who are already using Student
                        Portal to succeed in their academic goals.
                    </p>
                    <a
                        href="/login"
                        class="brutal-btn bg-ink text-paper px-8 py-3 text-base"
                    >
                        Log In to Your Account
                    </a>
                </div>
            </div>
        </section>

        <!-- Stats Section -->
        <section class="py-20 px-4 sm:px-6 lg:px-8 border-t-4 border-ink">
            <div class="max-w-6xl mx-auto">
                <div class="grid grid-cols-1 md:grid-cols-4 gap-6 text-center">
                    {
                        stats.map((s) => (
                            <div class="brutal-panel py-8 px-4">
                                <div class="text-4xl font-black text-accent-2 mb-2">
                                    {s.value}
                                </div>
                                <p class="text-ink/70 font-mono uppercase text-sm">
                                    {s.label}
                                </p>
                            </div>
                        ))
                    }
                </div>
            </div>
        </section>
    </div>
</PageLayout>
