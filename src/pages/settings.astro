---
import PageLayout from "@/layouts/PageLayout.astro";
---

<PageLayout>
    <div
        class="min-h-screen bg-gradient-to-br from-blue-50 to-indigo-100 py-12 px-4 sm:px-6 lg:px-8"
    >
        <div class="max-w-5xl mx-auto">
            <!-- Settings Header -->
            <div class="mb-8">
                <h1 class="text-4xl font-bold text-gray-900">Settings</h1>
                <p class="text-gray-600 mt-2">
                    Manage your account and preferences
                </p>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
                <!-- Settings Sidebar Navigation -->
                <div class="lg:col-span-1">
                    <div class="bg-white rounded-lg shadow p-6 sticky top-6">
                        <h2 class="text-lg font-semibold text-gray-900 mb-4">
                            Settings Menu
                        </h2>
                        <nav class="space-y-2">
                            <a
                                href="#account"
                                class="block px-4 py-2 bg-indigo-50 text-indigo-600 rounded-lg font-medium"
                                >Account</a
                            >
                            <a
                                href="#privacy"
                                class="block px-4 py-2 text-gray-700 hover:bg-gray-100 rounded-lg"
                                >Privacy</a
                            >
                            <a
                                href="#notifications"
                                class="block px-4 py-2 text-gray-700 hover:bg-gray-100 rounded-lg"
                                >Notifications</a
                            >
                            <a
                                href="#academic"
                                class="block px-4 py-2 text-gray-700 hover:bg-gray-100 rounded-lg"
                                >Academic</a
                            >
                            <a
                                href="#appearance"
                                class="block px-4 py-2 text-gray-700 hover:bg-gray-100 rounded-lg"
                                >Appearance</a
                            >
                            <a
                                href="#security"
                                class="block px-4 py-2 text-gray-700 hover:bg-gray-100 rounded-lg"
                                >Security</a
                            >
                        </nav>
                    </div>
                </div>

                <!-- Settings Content -->
                <div class="lg:col-span-3 space-y-6">
                    <!-- Account Settings -->
                    <div id="account" class="bg-white rounded-lg shadow p-6">
                        <h2
                            class="text-2xl font-bold text-gray-900 mb-6 pb-4 border-b border-gray-200"
                        >
                            Account Settings
                        </h2>

                        <div class="space-y-6">
                            <div>
                                <label
                                    class="block text-sm font-semibold text-gray-900 mb-2"
                                    >Full Name</label
                                >
                                <input
                                    type="text"
                                    value="Alex Johnson"
                                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500"
                                />
                            </div>

                            <div>
                                <label
                                    class="block text-sm font-semibold text-gray-900 mb-2"
                                    >Email Address</label
                                >
                                <input
                                    type="email"
                                    value="alex.johnson@iiit.ac.in"
                                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500"
                                />
                            </div>

                            <div>
                                <label
                                    class="block text-sm font-semibold text-gray-900 mb-2"
                                    >Roll Number</label
                                >
                                <input
                                    type="text"
                                    value="2026201063"
                                    disabled
                                    class="w-full px-4 py-2 border border-gray-300 rounded-lg bg-gray-50 text-gray-600"
                                />
                                <p class="text-xs text-gray-500 mt-1">
                                    Roll number cannot be changed
                                </p>
                            </div>

                            <div>
                                <label
                                    class="block text-sm font-semibold text-gray-900 mb-2"
                                    >Phone Number</label
                                >
                                <input
                                    type="tel"
                                    placeholder="+91-XXXXXXXXXX"
                                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500"
                                />
                            </div>

                            <div class="pt-4">
                                <button
                                    class="bg-indigo-600 text-white px-6 py-2 rounded-lg font-semibold hover:bg-indigo-700 transition"
                                    >Save Changes</button
                                >
                            </div>
                        </div>
                    </div>

                    <!-- Privacy Settings -->
                    <div id="privacy" class="bg-white rounded-lg shadow p-6">
                        <h2
                            class="text-2xl font-bold text-gray-900 mb-6 pb-4 border-b border-gray-200"
                        >
                            Privacy Settings
                        </h2>

                        <div class="space-y-5">
                            <div
                                class="flex items-center justify-between p-4 border border-gray-200 rounded-lg"
                            >
                                <div>
                                    <h3 class="font-semibold text-gray-900">
                                        Profile Visibility
                                    </h3>
                                    <p class="text-sm text-gray-600">
                                        Allow other students to view your
                                        profile
                                    </p>
                                </div>
                                <label class="flex items-center cursor-pointer">
                                    <input
                                        type="checkbox"
                                        checked
                                        class="w-5 h-5 text-indigo-600 rounded"
                                    />
                                </label>
                            </div>

                            <div
                                class="flex items-center justify-between p-4 border border-gray-200 rounded-lg"
                            >
                                <div>
                                    <h3 class="font-semibold text-gray-900">
                                        Show GPA Publicly
                                    </h3>
                                    <p class="text-sm text-gray-600">
                                        Display your GPA on your profile
                                    </p>
                                </div>
                                <label class="flex items-center cursor-pointer">
                                    <input
                                        type="checkbox"
                                        class="w-5 h-5 text-indigo-600 rounded"
                                    />
                                </label>
                            </div>

                            <div
                                class="flex items-center justify-between p-4 border border-gray-200 rounded-lg"
                            >
                                <div>
                                    <h3 class="font-semibold text-gray-900">
                                        Allow Messages from Classmates
                                    </h3>
                                    <p class="text-sm text-gray-600">
                                        Let other students send you messages
                                    </p>
                                </div>
                                <label class="flex items-center cursor-pointer">
                                    <input
                                        type="checkbox"
                                        checked
                                        class="w-5 h-5 text-indigo-600 rounded"
                                    />
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- Notification Settings -->
                    <div
                        id="notifications"
                        class="bg-white rounded-lg shadow p-6"
                    >
                        <h2
                            class="text-2xl font-bold text-gray-900 mb-6 pb-4 border-b border-gray-200"
                        >
                            Notification Preferences
                        </h2>

                        <div class="space-y-5">
                            <div
                                class="flex items-center justify-between p-4 border border-gray-200 rounded-lg"
                            >
                                <div>
                                    <h3 class="font-semibold text-gray-900">
                                        Email Notifications
                                    </h3>
                                    <p class="text-sm text-gray-600">
                                        Receive email for important updates
                                    </p>
                                </div>
                                <label class="flex items-center cursor-pointer">
                                    <input
                                        type="checkbox"
                                        checked
                                        class="w-5 h-5 text-indigo-600 rounded"
                                    />
                                </label>
                            </div>

                            <div
                                class="flex items-center justify-between p-4 border border-gray-200 rounded-lg"
                            >
                                <div>
                                    <h3 class="font-semibold text-gray-900">
                                        Assignment Reminders
                                    </h3>
                                    <p class="text-sm text-gray-600">
                                        Get notified before assignment deadlines
                                    </p>
                                </div>
                                <label class="flex items-center cursor-pointer">
                                    <input
                                        type="checkbox"
                                        checked
                                        class="w-5 h-5 text-indigo-600 rounded"
                                    />
                                </label>
                            </div>

                            <div
                                class="flex items-center justify-between p-4 border border-gray-200 rounded-lg"
                            >
                                <div>
                                    <h3 class="font-semibold text-gray-900">
                                        Grade Updates
                                    </h3>
                                    <p class="text-sm text-gray-600">
                                        Notify when grades are posted
                                    </p>
                                </div>
                                <label class="flex items-center cursor-pointer">
                                    <input
                                        type="checkbox"
                                        checked
                                        class="w-5 h-5 text-indigo-600 rounded"
                                    />
                                </label>
                            </div>

                            <div
                                class="flex items-center justify-between p-4 border border-gray-200 rounded-lg"
                            >
                                <div>
                                    <h3 class="font-semibold text-gray-900">
                                        Course Announcements
                                    </h3>
                                    <p class="text-sm text-gray-600">
                                        Receive course updates and announcements
                                    </p>
                                </div>
                                <label class="flex items-center cursor-pointer">
                                    <input
                                        type="checkbox"
                                        checked
                                        class="w-5 h-5 text-indigo-600 rounded"
                                    />
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- Academic Settings -->
                    <div id="academic" class="bg-white rounded-lg shadow p-6">
                        <h2
                            class="text-2xl font-bold text-gray-900 mb-6 pb-4 border-b border-gray-200"
                        >
                            Academic Settings
                        </h2>

                        <div class="space-y-6">
                            <div>
                                <label
                                    class="block text-sm font-semibold text-gray-900 mb-2"
                                    >Preferred Major</label
                                >
                                <select
                                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500"
                                >
                                    <option selected>Computer Science</option>
                                    <option>Information Technology</option>
                                    <option>Electronics & Communication</option>
                                    <option>Mechanical Engineering</option>
                                </select>
                            </div>

                            <div>
                                <label
                                    class="block text-sm font-semibold text-gray-900 mb-2"
                                    >Grade Scale</label
                                >
                                <select
                                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500"
                                >
                                    <option selected
                                        >10.0 Scale (IIIT Standard)</option
                                    >
                                    <option>4.0 Scale (GPA)</option>
                                    <option>100 Scale (Percentage)</option>
                                </select>
                            </div>

                            <div class="pt-4">
                                <button
                                    class="bg-indigo-600 text-white px-6 py-2 rounded-lg font-semibold hover:bg-indigo-700 transition"
                                    >Save Changes</button
                                >
                            </div>
                        </div>
                    </div>

                    <!-- Appearance Settings -->
                    <div id="appearance" class="bg-white rounded-lg shadow p-6">
                        <h2
                            class="text-2xl font-bold text-gray-900 mb-6 pb-4 border-b border-gray-200"
                        >
                            Appearance
                        </h2>

                        <div class="space-y-6">
                            <div>
                                <label
                                    class="block text-sm font-semibold text-gray-900 mb-4"
                                    >Theme</label
                                >
                                <div class="flex gap-4">
                                    <label
                                        class="flex items-center cursor-pointer"
                                    >
                                        <input
                                            type="radio"
                                            name="theme"
                                            checked
                                            class="w-4 h-4"
                                        />
                                        <span class="ml-2 text-gray-700"
                                            >Light Mode</span
                                        >
                                    </label>
                                    <label
                                        class="flex items-center cursor-pointer"
                                    >
                                        <input
                                            type="radio"
                                            name="theme"
                                            class="w-4 h-4"
                                        />
                                        <span class="ml-2 text-gray-700"
                                            >Dark Mode</span
                                        >
                                    </label>
                                    <label
                                        class="flex items-center cursor-pointer"
                                    >
                                        <input
                                            type="radio"
                                            name="theme"
                                            class="w-4 h-4"
                                        />
                                        <span class="ml-2 text-gray-700"
                                            >Auto (System)</span
                                        >
                                    </label>
                                </div>
                            </div>

                            <div>
                                <label
                                    class="block text-sm font-semibold text-gray-900 mb-4"
                                    >Display Language</label
                                >
                                <select
                                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500"
                                >
                                    <option selected>English</option>
                                    <option>Hindi</option>
                                    <option>Spanish</option>
                                </select>
                            </div>

                            <div class="pt-4">
                                <button
                                    class="bg-indigo-600 text-white px-6 py-2 rounded-lg font-semibold hover:bg-indigo-700 transition"
                                    >Save Changes</button
                                >
                            </div>
                        </div>
                    </div>

                    <!-- Security Settings -->
                    <div id="security" class="bg-white rounded-lg shadow p-6">
                        <h2
                            class="text-2xl font-bold text-gray-900 mb-6 pb-4 border-b border-gray-200"
                        >
                            Security
                        </h2>

                        <div class="space-y-4">
                            <button
                                class="w-full p-4 border border-gray-300 rounded-lg text-left hover:bg-gray-50 transition"
                            >
                                <h3 class="font-semibold text-gray-900">
                                    Change Password
                                </h3>
                                <p class="text-sm text-gray-600">
                                    Update your password regularly for better
                                    security
                                </p>
                            </button>

                            <button
                                class="w-full p-4 border border-gray-300 rounded-lg text-left hover:bg-gray-50 transition"
                            >
                                <h3 class="font-semibold text-gray-900">
                                    Two-Factor Authentication
                                </h3>
                                <p class="text-sm text-gray-600">
                                    Add an extra layer of security to your
                                    account
                                </p>
                            </button>

                            <button
                                class="w-full p-4 border border-gray-300 rounded-lg text-left hover:bg-gray-50 transition"
                            >
                                <h3 class="font-semibold text-gray-900">
                                    Active Sessions
                                </h3>
                                <p class="text-sm text-gray-600">
                                    View and manage your active login sessions
                                </p>
                            </button>

                            <button
                                class="w-full p-4 border border-red-300 rounded-lg text-left hover:bg-red-50 transition"
                            >
                                <h3 class="font-semibold text-red-600">
                                    Delete Account
                                </h3>
                                <p class="text-sm text-red-600">
                                    Permanently delete your account and all data
                                </p>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</PageLayout>
