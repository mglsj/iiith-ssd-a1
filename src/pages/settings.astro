---
import PageLayout from "@/layouts/PageLayout.astro";

const navItems = [
    { href: "#account", label: "Account", active: true },
    { href: "#privacy", label: "Privacy" },
    { href: "#notifications", label: "Notifications" },
    { href: "#academic", label: "Academic" },
    { href: "#appearance", label: "Appearance" },
    { href: "#security", label: "Security" },
];

const privacyToggles = [
    {
        title: "Profile Visibility",
        desc: "Allow other students to view your profile",
        checked: true,
    },
    {
        title: "Show GPA Publicly",
        desc: "Display your GPA on your profile",
        checked: false,
    },
    {
        title: "Allow Messages from Classmates",
        desc: "Let other students send you messages",
        checked: true,
    },
];

const notificationToggles = [
    {
        title: "Email Notifications",
        desc: "Receive email for important updates",
        checked: true,
    },
    {
        title: "Assignment Reminders",
        desc: "Get notified before assignment deadlines",
        checked: true,
    },
    {
        title: "Grade Updates",
        desc: "Notify when grades are posted",
        checked: true,
    },
    {
        title: "Course Announcements",
        desc: "Receive course updates and announcements",
        checked: true,
    },
];

const securityActions = [
    {
        title: "Change Password",
        desc: "Update your password regularly for better security",
    },
    {
        title: "Two-Factor Authentication",
        desc: "Add an extra layer of security to your account",
    },
    {
        title: "Active Sessions",
        desc: "View and manage your active login sessions",
    },
];
---

<PageLayout>
    <div class="flex-auto py-12 px-4 sm:px-6 lg:px-8">
        <div class="max-w-5xl mx-auto">
            <!-- Settings Header -->
            <div class="mb-8">
                <h1 class="text-3xl sm:text-4xl font-black uppercase tracking-tight">
                    Settings
                </h1>
                <p class="mt-2 font-mono text-sm text-ink/70">
                    Manage your account and preferences
                </p>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
                <!-- Settings Sidebar Navigation -->
                <div class="lg:col-span-1">
                    <div class="brutal-panel p-6 sticky top-24">
                        <h2 class="text-lg font-black mb-4 uppercase">
                            Settings Menu
                        </h2>
                        <nav class="space-y-1">
                            {
                                navItems.map((item) => (
                                    <a
                                        href={item.href}
                                        class={`block px-4 py-2 font-bold text-sm uppercase border-2 ${
                                            item.active
                                                ? "bg-ink text-paper border-ink"
                                                : "border-transparent hover:border-ink"
                                        }`}
                                    >
                                        {item.label}
                                    </a>
                                ))
                            }
                        </nav>
                    </div>
                </div>

                <!-- Settings Content -->
                <div class="lg:col-span-3 space-y-6">
                    <!-- Account Settings -->
                    <div id="account" class="brutal-panel p-6">
                        <h2
                            class="text-2xl font-black mb-6 pb-4 uppercase border-b-[3px] border-ink"
                        >
                            Account Settings
                        </h2>

                        <div class="space-y-6">
                            <div>
                                <label
                                    for="full-name"
                                    class="block text-sm font-bold uppercase mb-2"
                                    >Full Name</label
                                >
                                <input
                                    id="full-name"
                                    type="text"
                                    value="Alex Johnson"
                                    class="brutal-input w-full px-4 py-2"
                                />
                            </div>

                            <div>
                                <label
                                    for="email-address"
                                    class="block text-sm font-bold uppercase mb-2"
                                    >Email Address</label
                                >
                                <input
                                    id="email-address"
                                    type="email"
                                    value="alex.johnson@iiit.ac.in"
                                    class="brutal-input w-full px-4 py-2"
                                />
                            </div>

                            <div>
                                <label
                                    for="roll-number"
                                    class="block text-sm font-bold uppercase mb-2"
                                    >Roll Number</label
                                >
                                <input
                                    id="roll-number"
                                    type="text"
                                    value="2026201063"
                                    disabled
                                    class="brutal-input w-full px-4 py-2"
                                />
                                <p class="text-xs text-ink/60 mt-1 font-mono">
                                    Roll number cannot be changed
                                </p>
                            </div>

                            <div>
                                <label
                                    for="phone-number"
                                    class="block text-sm font-bold uppercase mb-2"
                                    >Phone Number</label
                                >
                                <input
                                    id="phone-number"
                                    type="tel"
                                    placeholder="+91-XXXXXXXXXX"
                                    class="brutal-input w-full px-4 py-2"
                                />
                            </div>

                            <div class="pt-4">
                                <button class="brutal-btn px-6 py-2"
                                    >Save Changes</button
                                >
                            </div>
                        </div>
                    </div>

                    <!-- Privacy Settings -->
                    <div id="privacy" class="brutal-panel p-6">
                        <h2
                            class="text-2xl font-black mb-6 pb-4 uppercase border-b-[3px] border-ink"
                        >
                            Privacy Settings
                        </h2>

                        <div class="space-y-4">
                            {
                                privacyToggles.map((t) => (
                                    <div class="flex items-center justify-between p-4 brutal-border">
                                        <div>
                                            <h3 class="font-bold">
                                                {t.title}
                                            </h3>
                                            <p class="text-sm text-ink/70">
                                                {t.desc}
                                            </p>
                                        </div>
                                        <label class="flex items-center cursor-pointer">
                                            <input
                                                type="checkbox"
                                                checked={t.checked}
                                                aria-label={t.title}
                                                class="brutal-checkbox w-6 h-6"
                                            />
                                        </label>
                                    </div>
                                ))
                            }
                        </div>
                    </div>

                    <!-- Notification Settings -->
                    <div id="notifications" class="brutal-panel p-6">
                        <h2
                            class="text-2xl font-black mb-6 pb-4 uppercase border-b-[3px] border-ink"
                        >
                            Notification Preferences
                        </h2>

                        <div class="space-y-4">
                            {
                                notificationToggles.map((t) => (
                                    <div class="flex items-center justify-between p-4 brutal-border">
                                        <div>
                                            <h3 class="font-bold">
                                                {t.title}
                                            </h3>
                                            <p class="text-sm text-ink/70">
                                                {t.desc}
                                            </p>
                                        </div>
                                        <label class="flex items-center cursor-pointer">
                                            <input
                                                type="checkbox"
                                                checked={t.checked}
                                                aria-label={t.title}
                                                class="brutal-checkbox w-6 h-6"
                                            />
                                        </label>
                                    </div>
                                ))
                            }
                        </div>
                    </div>

                    <!-- Academic Settings -->
                    <div id="academic" class="brutal-panel p-6">
                        <h2
                            class="text-2xl font-black mb-6 pb-4 uppercase border-b-[3px] border-ink"
                        >
                            Academic Settings
                        </h2>

                        <div class="space-y-6">
                            <div>
                                <label
                                    class="block text-sm font-bold uppercase mb-2"
                                    >Preferred Major</label
                                >
                                <select class="brutal-input w-full px-4 py-2">
                                    <option selected>Computer Science</option>
                                    <option>Information Technology</option>
                                    <option>Electronics & Communication</option
                                    >
                                    <option>Mechanical Engineering</option>
                                </select>
                            </div>

                            <div>
                                <label
                                    class="block text-sm font-bold uppercase mb-2"
                                    >Grade Scale</label
                                >
                                <select class="brutal-input w-full px-4 py-2">
                                    <option selected
                                        >10.0 Scale (IIIT Standard)</option
                                    >
                                    <option>4.0 Scale (GPA)</option>
                                    <option>100 Scale (Percentage)</option>
                                </select>
                            </div>

                            <div class="pt-4">
                                <button class="brutal-btn px-6 py-2"
                                    >Save Changes</button
                                >
                            </div>
                        </div>
                    </div>

                    <!-- Appearance Settings -->
                    <div id="appearance" class="brutal-panel p-6">
                        <h2
                            class="text-2xl font-black mb-6 pb-4 uppercase border-b-[3px] border-ink"
                        >
                            Appearance
                        </h2>

                        <div class="space-y-6">
                            <div>
                                <label
                                    class="block text-sm font-bold uppercase mb-4"
                                    >Theme</label
                                >
                                <div class="flex flex-wrap gap-4">
                                    <label
                                        class="flex items-center cursor-pointer"
                                    >
                                        <input
                                            type="radio"
                                            name="theme"
                                            checked
                                            class="brutal-radio w-5 h-5"
                                        />
                                        <span class="ml-2 font-medium"
                                            >Light Mode</span
                                        >
                                    </label>
                                    <label
                                        class="flex items-center cursor-pointer"
                                    >
                                        <input
                                            type="radio"
                                            name="theme"
                                            class="brutal-radio w-5 h-5"
                                        />
                                        <span class="ml-2 font-medium"
                                            >Dark Mode</span
                                        >
                                    </label>
                                    <label
                                        class="flex items-center cursor-pointer"
                                    >
                                        <input
                                            type="radio"
                                            name="theme"
                                            class="brutal-radio w-5 h-5"
                                        />
                                        <span class="ml-2 font-medium"
                                            >Auto (System)</span
                                        >
                                    </label>
                                </div>
                            </div>

                            <div>
                                <label
                                    class="block text-sm font-bold uppercase mb-4"
                                    >Display Language</label
                                >
                                <select class="brutal-input w-full px-4 py-2">
                                    <option selected>English</option>
                                    <option>Hindi</option>
                                    <option>Spanish</option>
                                </select>
                            </div>

                            <div class="pt-4">
                                <button class="brutal-btn px-6 py-2"
                                    >Save Changes</button
                                >
                            </div>
                        </div>
                    </div>

                    <!-- Security Settings -->
                    <div id="security" class="brutal-panel p-6">
                        <h2
                            class="text-2xl font-black mb-6 pb-4 uppercase border-b-[3px] border-ink"
                        >
                            Security
                        </h2>

                        <div class="space-y-4">
                            {
                                securityActions.map((a) => (
                                    <button class="w-full p-4 brutal-border text-left hover:bg-accent/20 transition">
                                        <h3 class="font-bold">{a.title}</h3>
                                        <p class="text-sm text-ink/70">
                                            {a.desc}
                                        </p>
                                    </button>
                                ))
                            }

                            <button
                                id="delete-account-btn"
                                class="w-full p-4 brutal-border border-accent-2 text-left hover:bg-accent-2/10 transition"
                            >
                                <h3 class="font-bold text-accent-2">
                                    Delete Account
                                </h3>
                                <p class="text-sm text-accent-2">
                                    Permanently delete your account and all
                                    data
                                </p>
                            </button>
                            <p
                                id="delete-account-status"
                                class="text-sm font-mono text-ink/70"
                                aria-live="polite"
                            />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        const deleteBtn = document.getElementById("delete-account-btn");
        const status = document.getElementById("delete-account-status");

        deleteBtn?.addEventListener("click", () => {
            const confirmed = confirm(
                "This will permanently delete your account and all associated data. This cannot be undone. Continue?",
            );
            if (!confirmed || !status) return;

            status.textContent =
                "Account deletion requested. (Demo only — no data was actually deleted.)";
            deleteBtn.setAttribute("disabled", "true");
            deleteBtn.classList.add("opacity-50", "pointer-events-none");
        });
    </script>
</PageLayout>
