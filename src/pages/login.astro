---
import PageLayout from "@/layouts/PageLayout.astro";
---

<PageLayout>
    <div
        class="w-full flex-auto flex items-center justify-center px-4 sm:px-6 lg:px-8 py-12"
    >
        <div class="w-full max-w-md">
            <!-- Login Card -->
            <div class="brutal-panel overflow-hidden">
                <!-- Header -->
                <div class="bg-ink px-6 py-8 border-b-[3px] border-ink">
                    <h1
                        class="text-3xl font-black text-paper text-center uppercase tracking-tight"
                    >
                        Welcome Back
                    </h1>
                    <p class="text-paper/70 text-center mt-2 font-mono text-sm">
                        Sign in to your account
                    </p>
                </div>

                <!-- Form -->
                <form id="loginForm" class="p-6 sm:p-8 flex flex-col">
                    <div class="mb-5">
                        <label
                            for="username"
                            class="block text-sm font-bold uppercase mb-2"
                        >
                            Username or Email
                        </label>
                        <input
                            type="text"
                            id="username"
                            name="username"
                            placeholder="Enter your username or email"
                            class="brutal-input w-full px-4 py-2"
                            required
                        />
                    </div>

                    <div class="mb-6">
                        <label
                            for="password"
                            class="block text-sm font-bold uppercase mb-2"
                        >
                            Password
                        </label>
                        <input
                            type="password"
                            id="password"
                            name="password"
                            placeholder="Enter your password"
                            class="brutal-input w-full px-4 py-2"
                            required
                        />
                    </div>

                    <div class="flex items-center justify-between mb-6">
                        <label class="flex items-center">
                            <input
                                type="checkbox"
                                name="remember"
                                class="brutal-checkbox w-5 h-5"
                            />
                            <span class="ml-2 text-sm font-medium"
                                >Remember me</span
                            >
                        </label>
                        <a
                            href="#"
                            class="text-sm font-bold uppercase underline underline-offset-4"
                        >
                            Forgot password?
                        </a>
                    </div>

                    <button type="submit" class="brutal-btn w-full py-2 mb-4">
                        Sign In
                    </button>
                </form>

                <!-- Footer -->
                <div class="px-6 sm:px-8 pb-6 border-t-[3px] border-ink">
                    <p class="text-center text-sm mt-4">
                        Don't have an account?
                        <a
                            href="/signup"
                            class="font-bold underline underline-offset-4"
                        >
                            Sign up here
                        </a>
                    </p>
                </div>
            </div>

            <!-- Additional Info -->
            <div class="mt-8 text-center">
                <p class="text-sm font-mono">
                    Contact support at <a
                        href="mailto:support@iiit.ac.in"
                        class="font-bold underline underline-offset-4"
                        >support@iiit.ac.in</a
                    >
                </p>
            </div>
        </div>
    </div>
</PageLayout>
